# antigravity-interface configuration (env prefix AGI_). Copy to .env or export.

# ── HTTP server ──────────────────────────────────────────────────────────────
AGI_HOST=127.0.0.1
AGI_PORT=8788

# ── Auth ─────────────────────────────────────────────────────────────────────
# Optional bearer token gating every /v1 request. Safe to leave UNSET only on a
# loopback bind. The server REFUSES to start on a non-loopback host unless this
# is set — it drives agy with --dangerously-skip-permissions, so an open bind
# with no key is remote code execution for anyone who can reach the port.
# AGI_API_KEY=choose-a-long-random-secret

# ── Antigravity CLI ──────────────────────────────────────────────────────────
AGI_AGY_BIN=agy
# Model used when the request names none. Display name or agy slug, must exist
# in `agy models`.
AGI_DEFAULT_MODEL=Gemini 3.8 Flash (Medium)
# AGI_DEFAULT_EFFORT=high
# Unknown `model` ids → 400 model_not_found (true) or silently the default (false).
AGI_STRICT_MODEL=true
# Live catalog: `agy models` is run at startup and every N seconds so new model
# releases appear on /v1/models without a code change. 0 = startup only.
AGI_MODEL_CATALOG_REFRESH_S=3600

# ── Prompt handling ──────────────────────────────────────────────────────────
# The prompt is delivered to agy over stdin (--input-format stream-json), so
# there is no argv size ceiling. This is a sanity cap in UTF-8 bytes; larger
# requests get 400 context_length_exceeded instead of a doomed upstream call.
AGI_MAX_PROMPT_BYTES=4000000
# Whole HTTP body (including JSON, schemas and base64), and upload deadline.
AGI_MAX_REQUEST_BYTES=32000000
AGI_BODY_TIMEOUT_S=30
AGI_MAX_IMAGES=16
AGI_MAX_IMAGE_BYTES=8000000
AGI_MAX_TOTAL_IMAGE_BYTES=16000000
AGI_MAX_TOOLS=128
AGI_MAX_TOOL_SCHEMA_BYTES=1000000
# Session permits include suspended MCP conversations. Continuations reuse theirs.
AGI_MAX_SESSIONS=8
AGI_MAX_SUSPENDED_SESSIONS=4
AGI_MAX_QUEUED_REQUESTS=16
AGI_ADMISSION_TIMEOUT_S=5
AGI_EVENT_QUEUE_SIZE=256
AGI_MAX_PENDING_TOOL_CALLS=32
AGI_STDIN_TIMEOUT_S=30
# Per-workspace attachment retention. Active/suspended workspaces are pinned.
AGI_ATTACHMENT_TTL_S=86400
AGI_ATTACHMENT_MAX_BYTES=256000000
AGI_ATTACHMENT_GC_INTERVAL_S=300
# Never let user content be interpreted as an agy slash command / skill.
AGI_DISABLE_SLASH_COMMANDS=true

# ── System prompt via managed agent ──────────────────────────────────────────
# Deliver the request's system message as a REAL system prompt: it is written
# as an agent definition (agents/hermes-<hash>.md) into a server-managed plugin
# and agy is spawned with --agent <slug>. The agent body overrides the CLI's
# built-in persona and stays in effect across conversation resumes. When false
# the system message falls back to a preamble. readonly/none still require a
# neutral agent; plugin write failure returns 503 rather than granting full tools.
AGI_SYSTEM_PROMPT_VIA_AGENT=true
# AGI_AGENT_PLUGIN_PATH=~/.gemini/config/plugins/hermes-bridge
AGI_AGENT_CACHE_MAX=64

# ── Builtin-tool exposure (security) ────────────────────────────────────────
# Which Antigravity builtins the model may use on requests WITHOUT `tools`
# (plain chat — hermes' compression, title generation, approval, vision, …).
# The agent frontmatter `tools:` list is enforced as an allowlist by agy.
#   readonly  view_file only (images still work; no shell, no writes, no browser)
#   none      no builtin tools at all
#   all       legacy: tools: "*"  — arbitrary code execution from untrusted content
AGI_PLAIN_CHAT_TOOLS=readonly
# Tool-passthrough turns must expose call_mcp_tool, which only "*" grants.
AGI_TOOL_TURN_TOOLS=all

# ── Reasoning / thinking passthrough ─────────────────────────────────────────
# Always on (no toggle): the model's thinking surfaces as `reasoning_content`,
# read best-effort from agy's internal brain transcript. Override the brain
# location only for nonstandard installs.
# AGI_AGY_BRAIN_PATH=~/.gemini/antigravity-cli/brain

# ── Image input ──────────────────────────────────────────────────────────────
# Write data-URL images from OpenAI image_url content parts to
# <workdir>/attachments/ and reference the file in the prompt; agy's view_file
# lets the (multimodal) model see them. Needs AGI_PLAIN_CHAT_TOOLS != none.
AGI_IMAGE_INPUT=true

# ── Conversation continuity ──────────────────────────────────────────────────
# History-prefix -> agy conversation id cache: follow-ups send only the newest
# user message with --conversation <id> instead of re-folding the transcript.
AGI_CONVERSATION_CACHE_MAX=256
AGI_CONVERSATION_CACHE_TTL_S=3600

# ── MCP config registration (tool calling) ──────────────────────────────────
# Tool-turn conversations register per-conversation server entries ("hermes",
# "hermes2", ...) in the shared Antigravity MCP config — the ONLY file agy
# honors. Entries are added before spawn and removed at close; foreign entries
# are never touched.
AGI_MANAGE_MCP_CONFIG=true
# AGI_MCP_CONFIG_PATH=~/.gemini/config/mcp_config.json

# ── Output formatting ────────────────────────────────────────────────────────
# Rewrite Markdown pipe tables to fenced monospace ASCII so they render in
# clients that don't support Markdown tables (e.g. Discord).
AGI_FLATTEN_MARKDOWN_TABLES=false

# ── Workspace (agy's --add-dir + cwd) ────────────────────────────────────────
# Per-request `workdir` overrides must resolve under one of
# AGI_ALLOWED_WORKDIR_ROOTS (a JSON list); empty => only the default is allowed.
AGI_DEFAULT_WORKDIR=~/agi-workspace
# AGI_ALLOWED_WORKDIR_ROOTS=["C:\\Projects"]

# ── Lifecycle (seconds) ──────────────────────────────────────────────────────
AGI_REQUEST_TIMEOUT_S=600
AGI_SUSPENDED_TTL_S=300
AGI_IDLE_SESSION_TTL_S=900
AGI_GC_INTERVAL_S=30
# Non-streaming requests poll for a vanished client at this interval and kill
# the agy subprocess instead of letting it run to AGI_REQUEST_TIMEOUT_S.
AGI_DISCONNECT_POLL_S=1.0

# ── Logging ──────────────────────────────────────────────────────────────────
AGI_LOG_LEVEL=INFO
# Emit per-turn latency metrics (spawn_ms / ttft_ms / total_ms / tok_per_s) to
# the "agi.timing" logger at INFO. Off by default so normal operation pays
# nothing; scripts/bench.py turns it on for the throwaway benchmark instance.
AGI_TIMING_LOG=false
