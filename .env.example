# antigravity-interface configuration (env prefix AGI_). Copy to .env or export.

# ── HTTP server ──────────────────────────────────────────────────────────────
AGI_HOST=127.0.0.1
AGI_PORT=8788

# ── Auth ─────────────────────────────────────────────────────────────────────
# Optional bearer token gating every /v1 request. Safe to leave UNSET only on a
# loopback bind. The server REFUSES to start on a non-loopback host unless this
# is set — it drives agy with --dangerously-skip-permissions, so an open bind
# with no key is remote code execution for anyone who can reach the port.
# AGI_API_KEY=choose-a-long-random-secret

# ── Antigravity CLI ──────────────────────────────────────────────────────────
AGI_AGY_BIN=agy
# Model used when the request names none. Display name or agy slug, must exist
# in `agy models`.
AGI_DEFAULT_MODEL=Gemini 3.8 Flash (Medium)
# AGI_DEFAULT_EFFORT=high
# Unknown `model` ids → 400 model_not_found (true) or silently the default (false).
AGI_STRICT_MODEL=true
# Live catalog: `agy models` is run at startup and every N seconds so new model
# releases appear on /v1/models without a code change. 0 = startup only.
AGI_MODEL_CATALOG_REFRESH_S=3600

# ── Prompt handling ──────────────────────────────────────────────────────────
# The prompt is delivered to agy over stdin (--input-format stream-json), so
# there is no argv size ceiling. This is a sanity cap in UTF-8 bytes; larger
# requests get 400 context_length_exceeded instead of a doomed upstream call.
AGI_MAX_PROMPT_BYTES=4000000
# Whole HTTP body (including JSON, schemas and base64), and upload deadline.
AGI_MAX_REQUEST_BYTES=32000000
AGI_BODY_TIMEOUT_S=30
AGI_MAX_IMAGES=16
AGI_MAX_IMAGE_BYTES=8000000
AGI_MAX_TOTAL_IMAGE_BYTES=16000000
AGI_MAX_TOOLS=128
AGI_MAX_TOOL_SCHEMA_BYTES=1000000
# No concurrency caps: every call gets its own agy process immediately
# (~200 MB RSS each; size the host for peak concurrency). Idle processes
# leave via AGI_IDLE_SESSION_TTL_S.
AGI_EVENT_QUEUE_SIZE=256
AGI_MAX_PENDING_TOOL_CALLS=32
AGI_STDIN_TIMEOUT_S=30
# Per-workspace attachment retention. Active/suspended workspaces are pinned.
AGI_ATTACHMENT_TTL_S=86400
AGI_ATTACHMENT_MAX_BYTES=256000000
AGI_ATTACHMENT_GC_INTERVAL_S=300
# Never let user content be interpreted as an agy slash command / skill.
AGI_DISABLE_SLASH_COMMANDS=true

# ── System prompt via managed agent ──────────────────────────────────────────
# Deliver the request's system message as a REAL system prompt: each spawn
# writes its own transient agent file (plugins/hermes-bridge/agents/
# hermes-<12 hex>.md) and runs agy with --agent hermes-<12 hex>; the file is
# deleted as soon as agy printed its first stdout line (it has read it by
# then). No lock: fresh boots run in parallel. When false the system message
# falls back to a preamble. readonly/none and tool turns still require the
# agent; plugin write failure returns 503 rather than granting full tools.
AGI_SYSTEM_PROMPT_VIA_AGENT=true
# AGI_AGENT_PLUGIN_PATH=~/.gemini/config/plugins/hermes-bridge
# Agent base name inside that plugin (per-spawn agents/<name>-<12 hex>.md). A
# second server on the same HOME should use its own plugin path AND name
# (scripts/bench.py sets both).
# AGI_AGENT_NAME=hermes
# Kill + fail (504) a spawn whose agy printed nothing within this many seconds
# (only that spawn waits; boots never queue). Leftover transient agent files
# older than 2x this value are swept by the GC loop.
AGI_AGENT_START_TIMEOUT_S=30
# Agent `inheritMcp`: false = tool turns see only their own hermes MCP server
# and plain chat none; true also exposes your servers from mcp_config.json.
AGI_INHERIT_USER_MCP=false

# ── Builtin-tool exposure (security) ────────────────────────────────────────
# Which Antigravity builtins the model may use on requests WITHOUT `tools`
# (plain chat — hermes' compression, title generation, approval, vision, …).
# The agent frontmatter `tools:` list is enforced as an allowlist by agy.
#   readonly  view_file only (images still work; no shell, no writes, no browser)
#   none      no builtin tools at all
#   all       every builtin (no tools: field) — arbitrary code execution from
#             untrusted content
AGI_PLAIN_CHAT_TOOLS=readonly
# Tool-passthrough turns must expose call_mcp_tool, which only the full set
# (no tools: field) grants on agy 1.4.8.
AGI_TOOL_TURN_TOOLS=all

# ── Reasoning / thinking passthrough ─────────────────────────────────────────
# Always on (no toggle): the model's thinking surfaces as `reasoning_content`,
# read best-effort from agy's internal brain transcript. Override the brain
# location only for nonstandard installs.
# AGI_AGY_BRAIN_PATH=~/.gemini/antigravity-cli/brain

# ── Image input ──────────────────────────────────────────────────────────────
# Write data-URL images from OpenAI image_url content parts to
# <workdir>/attachments/ and reference the file in the prompt; agy's view_file
# lets the (multimodal) model see them. Needs AGI_PLAIN_CHAT_TOOLS != none.
AGI_IMAGE_INPUT=true

# ── Conversation continuity (cross-turn reuse) ───────────────────────────────
# A process survives its turn and is parked IDLE; a follow-up whose history
# matches (incl. the answer exactly as returned) adopts it and only the newest
# user message is sent. false = one process per turn. Once the parked process
# is gone (AGI_IDLE_SESSION_TTL_S, crash) a follow-up starts fresh (a warm-pool
# process when one matches) with the whole history folded into its first turn.
AGI_SESSION_REUSE=true
# Recently delivered tool_call_ids: a duplicate continuation for them gets 409
# instead of a rebuild that would re-run the turn (and its side effects).
AGI_COMPLETED_CALL_MEMORY_MAX=1024
AGI_COMPLETED_CALL_MEMORY_S=600

# ── Shared MCP config (legacy cleanup only) ─────────────────────────────────
# Tool turns declare their MCP server in the agent file; the shared
# ~/.gemini/config/mcp_config.json is never written. At startup, hermes/hermesN
# slots older builds left there (loopback /mcp/conv<N>-<id> URLs only) are
# removed once, after a one-time backup. false = never touch the file at all.
AGI_MANAGE_MCP_CONFIG=true
# AGI_MCP_CONFIG_PATH=~/.gemini/config/mcp_config.json

# ── Output formatting ────────────────────────────────────────────────────────
# Rewrite Markdown pipe tables to fenced monospace ASCII so they render in
# clients that don't support Markdown tables (e.g. Discord).
AGI_FLATTEN_MARKDOWN_TABLES=false

# ── Workspace (agy's --add-dir + cwd) ────────────────────────────────────────
# Per-request `workdir` overrides must resolve under one of
# AGI_ALLOWED_WORKDIR_ROOTS (a JSON list); empty => only the default is allowed.
AGI_DEFAULT_WORKDIR=~/agi-workspace
# AGI_ALLOWED_WORKDIR_ROOTS=["C:\\Projects"]

# ── Lifecycle (seconds) ──────────────────────────────────────────────────────
AGI_REQUEST_TIMEOUT_S=600
AGI_SUSPENDED_TTL_S=300
AGI_IDLE_SESSION_TTL_S=900
AGI_GC_INTERVAL_S=30
# Non-streaming requests poll for a vanished client at this interval and kill
# the agy subprocess instead of letting it run to AGI_REQUEST_TIMEOUT_S.
AGI_DISCONNECT_POLL_S=1.0
# Tool results for a conversation that is already gone (GC'd past
# AGI_SUSPENDED_TTL_S, or lost to a restart): rebuild a fresh turn from the full
# history the client resent (true) instead of answering 409 (false).
AGI_REBUILD_ON_EXPIRY=true

# ── Warm pool ────────────────────────────────────────────────────────────────
# Pre-booted idle agy procs for the FIRST turn of new conversations — plain and
# tool turns (tool procs pre-mint their /mcp/<conv_id> and get the request's
# tools late-bound; adopted only by the same toolset). Saves the 1-3 s boot.
# Costs ~200 MB RSS per idle proc (its empty agy conversation is deleted when a
# never-adopted proc is recycled). 1-2 is the useful range for one user; 0 = off.
# Total across all warm signatures.
AGI_WARM_POOL_SIZE=2
# Distinct signatures (model + agent/system prompt + toolset) kept warm at once,
# the hottest among recent fresh turns; AGI_WARM_POOL_SIZE is split across them.
AGI_WARM_POOL_SIGNATURES=2
# Recycle an idle pooled proc after this long (stale auth/model guard).
AGI_WARM_POOL_MAX_IDLE_S=600

# ── Housekeeping (zero footprint; README "Footprint & cleanup") ────────────
# The server records every agy conversation / process / workdir it creates in
# its own ledger and deletes that agy state as soon as it can no longer be
# used: the moment its process exits (idle TTL, crash, eviction, pool discard,
# shutdown) and, at the next start, what a crashed run left behind.
# It NEVER deletes an agy conversation that is not in the ledger (your own
# agy / IDE data). Remove the whole footprint: stop the server, then
# `python -m app.purge`.
# State dir (ledger, per-process logs, instance lock). Default: Linux
# $XDG_STATE_HOME/hermes-antigravity (~/.local/state/...), Windows
# %LOCALAPPDATA%\hermes-antigravity.
# AGI_STATE_DIR=~/.local/state/hermes-antigravity
# agy's own state dir.
# AGI_AGY_STATE_ROOT=~/.gemini/antigravity-cli
# false = no ledger, no --log-file, no cleanup (agy's default footprint).
AGI_HOUSEKEEPING=true
# Periodic sweep: crashed runs, files a held handle delayed, schema caches,
# temp files, stale logs.
AGI_HOUSEKEEPING_INTERVAL_S=600
# Our acli/mcp/hermes-<8hex>/ tool-schema caches unused this long are removed.
AGI_MCP_CACHE_MAX_AGE_S=604800
# Keep a FAILED agy process' log (<state>/logs) for 7 days; others are deleted
# when their process ends.
AGI_KEEP_AGY_LOGS=false

# ── Logging ──────────────────────────────────────────────────────────────────
AGI_LOG_LEVEL=INFO
# Emit per-turn latency metrics (spawn_ms / ttft_ms / total_ms / tok_per_s) to
# the "agi.timing" logger at INFO. Off by default so normal operation pays
# nothing; scripts/bench.py turns it on for the throwaway benchmark instance.
AGI_TIMING_LOG=false
